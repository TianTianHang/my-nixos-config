--- a/src/virtualkeyboard/virtualkeyboardview.cpp
+++ b/src/virtualkeyboard/virtualkeyboardview.cpp
@@ -18,6 +18,7 @@
 #include "virtualkeyboard/virtualkeyboardview.h"
 #include <QQmlContext>
 #include <QQuickItem>
+#include <LayerShellQt/Window>
 #include "log.h"
 #include "screenwatcher.h"
 #include "shadowborderitem.h"
@@ -194,6 +195,21 @@ void VirtualKeyboardView::initView() {
     }
 
     view_->setGeometry(calculateInitialGeometry());
+    if (getDesktopType() == DesktopType::WAYLAND) {
+        auto *layerShellWindow = LayerShellQt::Window::get(view_.get());
+        layerShellWindow->setAnchors(LayerShellQt::Window::Anchors(
+            LayerShellQt::Window::AnchorTop |
+            LayerShellQt::Window::AnchorLeft));
+        layerShellWindow->setLayer(LayerShellQt::Window::LayerOverlay);
+        layerShellWindow->setKeyboardInteractivity(
+            LayerShellQt::Window::KeyboardInteractivityNone);
+        layerShellWindow->setActivateOnShow(false);
+        layerShellWindow->setScope("kylin-virtual-keyboard");
+        layerShellWindow->setDesiredSize(geometry().size());
+        const auto initialGeometry = geometry();
+        layerShellWindow->setMargins(QMargins(
+            initialGeometry.x(), initialGeometry.y(), 0, 0));
+    }
     emit positionChanged(geometry().topLeft());
     setViewOpacity();
 
