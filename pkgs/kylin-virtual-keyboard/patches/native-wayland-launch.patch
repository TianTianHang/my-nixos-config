diff --git a/data/org.ukui.virtualkeyboard.start.sh.in b/data/org.ukui.virtualkeyboard.start.sh.in
index c67cccd..35fea4c 100755
--- a/data/org.ukui.virtualkeyboard.start.sh.in
+++ b/data/org.ukui.virtualkeyboard.start.sh.in
@@ -6,7 +6,12 @@
 desktop_env=$(echo "$XDG_CURRENT_DESKTOP" | tr '[:upper:]' '[:lower:]')
 session_type=$(echo "$XDG_SESSION_TYPE" | tr '[:upper:]' '[:lower:]')
 
-if [[ "$desktop_env" == *"ukui"* ]] && [[ "$session_type" == "wayland" ]]; then
+# Avoid racing Fcitx5's XDG autostart with D-Bus activation from the GUI.
+until busctl --user status org.fcitx.Fcitx5 >/dev/null 2>&1; do
+    sleep 0.1
+done
+
+if [[ "$session_type" == "wayland" ]]; then
     exec @CMAKE_INSTALL_FULL_BINDIR@/kylin-virtual-keyboard
 else
     export QT_QPA_PLATFORM=xcb
