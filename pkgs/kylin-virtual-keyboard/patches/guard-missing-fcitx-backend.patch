     connect(serviceWatcher_.get(), SIGNAL(serviceUnregistered(const QString &)),
             this, SLOT(backendServiceUnregistered(const QString &)));
+
+    // Create the proxy immediately when Fcitx5 is already running. The watcher
+    // below recreates it when Fcitx5 starts later.
+    initVirtualKeyboardBackendInterface();
+    if (virtualKeyboardBackendInterface_->isValid()) {
+        backendServiceRegistered(virtualKeyboardBackendService);
+    }
